# configure_multiple_ips.yml
---
- name: Configurar múltiples IPs en eth0
  hosts: devices
  become: yes
  vars:
    subred_base: "192.168"
    subred_mask: "24"
    interface_target: "eth0"

  tasks:
    - name: Extraer número del hostname
      set_fact:
        numero_host: "{{ host_name | regex_replace('[^0-9]', '') }}"
        
    - name: Determinar si es profesor
      set_fact:
        es_profesor: "{{ 'profe' in host_name }}"
        
    - name: Calcular ID de aula
      set_fact:
        id_aula_calculado: "{{ numero_host | int // 100 }}"
        id_aula_final: "{{ id_aula | default(id_aula_calculado) }}"
        
    - name: Calcular número de máquina
      set_fact:
        numero_maquina: "{{ 250 if es_profesor else (numero_host | int % 100) }}"
        
    - name: Calcular IP del alias
      set_fact:
        ip_alias: "{{ subred_base }}.{{ id_aula_final }}.{{ numero_maquina }}"

    - name: Calcular CIDR del alias
      set_fact:
        cidr_alias: "{{ ip_alias }}/{{ subred_mask }}"
        
    - name: Mostrar información calculada
      debug:
        msg: |
          🔧 CONFIGURACIÓN CALCULADA:
          Host: {{ host_name }}
          Número: {{ numero_host }}
          Aula: {{ id_aula_final }}
          Máquina: {{ numero_maquina }} {{ '(PROFESOR)' if es_profesor else '(ALUMNO)' }}
          IP Alias: {{ cidr_alias }}
        
    - name: Verificar si ya existe la IP
      ansible.builtin.shell:
        cmd: "ip addr show {{ interface_target }} | grep '{{ ip_alias }}' && echo 'EXISTE' || echo 'NO_EXISTE'"
      register: ip_check
      changed_when: false
      
    - name: Crear configuración Netplan con IP adicional
      ansible.builtin.template:
        src: "netplan-multiple-ips.j2"
        dest: "/etc/netplan/99-multiple-ips-{{ host_name }}.yaml"
        owner: root
        group: root
        mode: '0644'
      when: ip_check.stdout == "NO_EXISTE"
      notify: aplicar_netplan

  handlers:
    - name: aplicar_netplan
      ansible.builtin.command:
        cmd: "netplan apply"
      async: 30
      poll: 5
