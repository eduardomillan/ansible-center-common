#!/bin/bash
# LOCAL FILE - NOT VERSIONED
# Copy this to password_ENV.txt and fill with your credentials
# source password_ENV.txt before running playbooks with --ask-pass or --ask-become-pass

# Your username on target machines
# Uncomment and set your username:
# export ANSIBLE_REMOTE_USER="your_username_here"

# Ansible sudo password
# Note: Using --ask-become-pass is recommended instead of storing password in file
# Uncomment only if you want to source this file before running playbooks:
# export ANSIBLE_BECOME_PASS="your_sudo_password"

# SSH key checking (disable only for lab environments)
# Uncomment to set:
# export ANSIBLE_HOST_KEY_CHECKING="False"

# Example usage:
# 1. Copy this file: cp password_ENV.txt.example password_ENV.txt
# 2. Edit password_ENV.txt with your credentials
# 3. Source before running playbooks: source password_ENV.txt
# 4. Run playbooks: ansible-playbook playbooks/change-hostname/change_host_name.yml -i inventories/inventory.ini -e "host_name=newname"
